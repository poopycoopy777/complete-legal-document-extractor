            },
            {
              "citationSpan": [
                19049,
                19059
              ],
              "proposition": "App.  p. 5178  (1958  ed.)  Title  Il provides   for such  a\n    statutory  proceeding  for the determination   of rights and duties  arising thereunder,   ss\n   204\u2014207, and courts  should,  therefore,  ordinarily  refrain from exercising  their\n    jurisdiction   in such  cases.\u201d",
              "propositionSpan": [
                18765,
                19047
              ],
              "signal": null
