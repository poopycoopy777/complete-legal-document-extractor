      "unattributedQuotes": [
        {
          "span": [
            4787,
            4808
          ],
          "raw_text": "\u201cMemorandum   of Law\u201d",
          "attribution_status": "unattributed",
          "attribution_basis": null
        },
        {
          "span": [
            6684,
            7261
          ],
          "raw_text": "\u201cThe April 5, 2026  Order  resolved   certain   discrete   audio  segments   through  an  in\n       camera  review.  It did not resolve  Plaintiff\u2019s claims  for declaratory  and injunctive\n          relief. Those claims  seek  a declaration   of    the parties\u2019rights  under  the\n       Enhance[d]   Law Enforcement    Integrity  Act, 24-31-902   C.R.S.,  and an injunction\n       against  the Defendants\u2019  ongoing practice  of muting body-worn camera audio in\n        esponses   to     ues     ade  after  a complaint   of  peace officer    misconduct h:\n       been  lodged.\u201d",
          "attribution_status": "unattributed",
          "attribution_basis": null
        },
        {
          "span": [
            7402,
            7975
          ],
          "raw_text": "\u201cThe legal controversy  underlying  these  claims  remains  live.  Defendants   continue\n          to assert   authority    to    mute body-worn       camera audio  under        neral  Colorado\n           riminatJustice     Records   Act     balancing  framework.   That  asserted     authorit)\n         overns  future  requests   unless  and    until this Court  or a reviewing  court    holds\n        otherwise.  A case  is not moot where  declaratory  or injunctive  relief would  still have\n          practical    legal  effect  on an  existing,  ongoing  controversy.\u201d",
          "attribution_status": "unattributed",
          "attribution_basis": null
        },
        {
          "span": [
            11926,
            12060
          ],
          "raw_text": "\u201cPlaintiff  is entitled  to an Order declaring  his right to receive  the unmuted  BWC\n        recordings   at issue  from Defendant.\u201d",
          "attribution_status": "unattributed",
          "attribution_basis": null
        },
        {
          "span": [
            21494,
            21537
          ],
          "raw_text": "\u201cis suffering and will continue  to suffer\u201d",
          "attribution_status": "unattributed",
          "attribution_basis": null
        }
      ]
    }
